# Copy to /etc/dexscreener-crawler.env (chmod 600)
API_SECRET=change-me-to-a-long-random-string
API_HOST=127.0.0.1
API_PORT=8080
# ALLOW_INSECURE_API=0
# USE_PROXY=0
# PROXY_LIST=
# ALERT_WEBHOOK_URL=

# P1.1 Telegram (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID_MAIN=
# TELEGRAM_CHAT_ID_ALERT=
# TELEGRAM_CHAT_ID_ADMIN=
# TELEGRAM_CHAT_ID=

# P1.2 Helius Solana logsSubscribe (optional)
# HELIUS_API_KEY=
# HELIUS_WS_URL=          # optional full WSS override
# HELIUS_HTTP_URL=        # optional HTTP RPC override for getTransaction
# HELIUS_PROGRAM_IDS=     # comma-separated; default = Raydium/Pump/Meteora/Orca (see solana_helius.py)
# HELIUS_MENTIONS=        # alias of HELIUS_PROGRAM_IDS
# HELIUS_PING_INTERVAL_SEC=120
# HELIUS_RECONNECT_MAX_SEC=60
# HELIUS_DISCONNECT_ALERT_AFTER=3
# INTEL_LOOP I-1 top-holder snapshots (paper observe, default ON).
# Extra RPC on confirmed Helius mints. Does not change buy gates.
# HOLDER_SNAPSHOT_ENABLED=1
# INTEL_LOOP I-3 bot markers (paper observe, default ON). No extra RPC.
# 0 skips bot_suspect labels. Does not skip orders.
# BOT_MARKERS_ENABLED=1

# P1.3 X API v2 social (optional — never commit the bearer)
# X_BEARER_TOKEN=
# X_DAILY_BUDGET_REQUESTS=100
# X_HOURLY_BUDGET_REQUESTS=20
# X_RATE_CAPACITY=5
# X_RATE_REFILL_PER_SEC=0.1
# X_SEARCH_MAX_RESULTS=10
# X_EARLY_WATCH_SEC=3600
# X_EARLY_WATCH_LIMIT=10
# X_HOT_WATCH_LIMIT=15
# X_MENTION_SPIKE_RATIO=3.0
# X_MENTION_SPIKE_MIN=5
# X_DUAL_SIGNAL_LOOKBACK_SEC=1800

# P2 multi-chain (default solana,ethereum,bsc,base)
# ENABLED_CHAINS=solana,ethereum,bsc,base
# CHAINS=solana   # alias of ENABLED_CHAINS

# P2 pair_history intervals (seconds)
# HISTORY_HOT_INTERVAL_SEC=300
# HISTORY_WARM_INTERVAL_SEC=1800
# HISTORY_COLD_INTERVAL_SEC=7200
# HISTORY_RETENTION_DAYS=14

# P2 quality — store alerts below this score but skip Telegram/webhook push
# ALERT_MIN_SCORE=25

# P3 risk / worker
# RISK_ENABLED=1
# RISK_API_URL=
# RISK_API_KEY=
# RISK_MAX_DEDUCTION=40
# WORKER_BACKEND=sqlite
# WORKER_DB_PATH=worker_queue.db
# REDIS_URL=

# P4
# RISK_PROVIDER=goplus
# GROK_REPORT_DIR=exports/reports
# GROK_REPORT_TELEGRAM=0
# PAPER_DB_PATH=paper_trading.db
# PAPER_START_CASH=10000

# P5 live trading — KEEP DISABLED unless you know what you are doing
# LIVE_TRADING_ENABLED=0
# LIVE_TRADING_CONFIRM=
# LIVE_KILL_SWITCH_PATH=LIVE_TRADING_DISABLED
# LIVE_MAX_ORDER_USD=25
# LIVE_MAX_DAILY_NOTIONAL_USD=100
# LIVE_EXCHANGE_API_URL=
# LIVE_EXCHANGE_API_KEY=
# LIVE_EXCHANGE_API_SECRET=
# ARB_MIN_SPREAD_PCT=3
# ARB_MIN_LIQ_USD=5000

# Stabilize: prefer single chain to cut noise (stabilize_run.sh defaults this)
# ENABLED_CHAINS=solana

# Paper cash: default 10000; use 1000 for small stabilize books
# PAPER_START_CASH=10000
# python paper_trade.py init --cash 1000
# python paper_trade.py init --cash 1000 --reset-cash

# Optional auto paper open after score (DEFAULT OFF)
# PAPER_AUTO_OPEN=0
# PAPER_AUTO_MIN_SCORE=70
# PAPER_AUTO_SIZE_USD=50

# Execution gateway Step B paper (DEFAULT OFF — keep resident loop gated)
# EXECUTION_PAPER_ENABLED=0
# EXECUTION_PAPER_TICK=0
# EXECUTION_PAPER_TP_CLAMP=1
# EXECUTION_PAPER_CLOSE_MIN_LIQ_USD=1000
# EXECUTION_PAPER_DB=paper_trading.db
# EXECUTION_LEDGER_PATH=execution_ledger.db
# EXECUTION_POLL_SEC=5

# Optional auto deep-DD after high score / new_listing (DEFAULT OFF)
# DD_AUTO_ENABLED=0
# DD_AUTO_MIN_SCORE=75
# DD_AUTO_ON_NEW_LISTING=0

# Telegram note: MAIN/ALERT may point at same admin chat during stabilize — OK.
# Prefer TELEGRAM_CHAT_ID_ADMIN for tests; MAIN/ALERT fall back to TELEGRAM_CHAT_ID then ADMIN.

# JEV Token Intelligence (optional — empty key = public scans)
# JEV_ENABLED=1
# JEV_BASE_URL=https://jevs.fun
# JEV_API_KEY=
# JEV_AUTH_MODE=header
# JEV_MAX_PER_MIN=7
# Suggested with auth tier (raise only if plan allows):
#   JEV_MAX_PER_MIN=15   # basic
#   JEV_MAX_PER_MIN=30   # pro
# JEV_HOT_INTERVAL_SEC=900
# JEV_HOT_LIMIT=40          # per-pass cap; open-position pins are tier 1
# JEV_PIN_MAX_SHARE=1.0     # share of slots pins may take (1.0 = all)
# JEV_ON_NEW_LISTING=0

# Indicators composite (weights 0 = off) + optional hook
# INDICATORS_ENABLED=1
# INDICATORS_WRITE_HISTORY_HOT=1
# INDICATORS_WEIGHT_TECHNICAL=0
# INDICATORS_WEIGHT_FUNDING=0
# INDICATORS_WEIGHT_SENTIMENT=0
# INDICATORS_ON_UPDATE_HOOK=0
# Sentiment / X indicators Step 3 (compute on; composite weight 0)
# SENTIMENT_ENABLED=1
# SENTIMENT_WRITE_HISTORY=1
# SENTIMENT_ALERT_LOOKBACK_SEC=21600

# Telegram 429 / rate-limit protection (Telegram stays enabled)
# TG_MAX_RETRIES=3
# TG_429_SLEEP_CAP_SEC=30
# TG_RATE_MIN_INTERVAL_SEC=1.0
# TG_RATE_PER_MIN=20
# TG_QUEUE_MAX=80
# TG_QUEUE_DROP_LOW=1
# ALERT_COOLDOWN_SEC=600
#
# Telegram push throttle (delivery only; detect/store unchanged) — see TG_PUSH_THROTTLE.md
# TELEGRAM_PUSH_EXCLUDE_TYPES=new_listing
# TELEGRAM_PUSH_MIN_SEVERITY=high
# TELEGRAM_PUSH_MIN_SCORE=35
# TELEGRAM_PUSH_COOLDOWN_SEC=600
