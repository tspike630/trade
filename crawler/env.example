# Copy relevant lines into .env (chmod 600). Never commit real secrets.

# ---------------------------------------------------------------------------
# JEV Token Intelligence (sources.jev) — optional API key
# Empty JEV_API_KEY = public unauthenticated scans (default / unchanged).
# ---------------------------------------------------------------------------
# JEV_ENABLED=1
# JEV_BASE_URL=https://jevs.fun
# JEV_API_KEY=
# Auth attachment: header (X-API-Key) | bearer (Authorization: Bearer) | query (api_key=)
# JEV_AUTH_MODE=header
# JEV_HOT_INTERVAL_SEC=900
# JEV_HOT_LIMIT=20
# JEV_ON_NEW_LISTING=0
# JEV_REQUEST_TIMEOUT_SEC=30
# JEV_RAW_MAX_CHARS=8000
# JEV_PENDING_PATH=exports/jev_pending.jsonl

# Suggested rate limits by tier (commented — raise only if your plan allows):
#   public / no key:  JEV_MAX_PER_MIN=7   # stay under IP 8/min
#   auth / basic:     JEV_MAX_PER_MIN=15
#   auth / pro:       JEV_MAX_PER_MIN=30
# JEV_MAX_PER_MIN=7

# After setting JEV_API_KEY, restart ONLY the JEV enricher (not main/indicators):
#   pkill -f 'python -m sources.jev' || true
#   nohup .venv/bin/python -m sources.jev --loop --interval 900 >> logs/jev.log 2>&1 &

# ---------------------------------------------------------------------------
# Indicators composite / hooks — ALL weights default 0 (scoring/alerts untouched)
# ---------------------------------------------------------------------------
# INDICATORS_ENABLED=1
# INDICATORS_WRITE_HISTORY_HOT=1
# INDICATORS_WEIGHT_TECHNICAL=0
# INDICATORS_WEIGHT_FUNDING=0
# INDICATORS_WEIGHT_SENTIMENT=0
# INDICATORS_ON_UPDATE_HOOK=0

# ---------------------------------------------------------------------------
# Sentiment / X indicators (Step 3) — compute on; composite weight stays 0
# ---------------------------------------------------------------------------
# SENTIMENT_ENABLED=1
# SENTIMENT_WRITE_HISTORY=1
# SENTIMENT_ALERT_LOOKBACK_SEC=21600
# SENTIMENT_SPIKE_MIN=3

# ---------------------------------------------------------------------------
# Execution gateway Step B/C — ALL default OFF (resident loop stays gated)
# ---------------------------------------------------------------------------
# EXECUTION_PAPER_ENABLED=0
# EXECUTION_PAPER_DB=
# EXECUTION_PAPER_TICK=0
# EXECUTION_POLL_SEC=5
# EXECUTION_LEDGER_PATH=

# Step C PositionManager (PM_ENABLED=0 → check_open pass-through)
# PM_ENABLED=0
# PM_TOKEN_DEDUP=0
# PM_STRATEGY_MUTEX=0
# PM_MAX_TOTAL_PCT=          # suggest 30 (percent points) when enabling
# PM_MAX_PER_TOKEN_PCT=      # suggest 10
# PM_MAX_OPEN_PER_STRATEGY=  # suggest 5
# PM_STRATEGY_PRIORITY=      # optional comma list, earlier = higher (arbitration)
# PM_PAPER_DB=               # optional; else EXECUTION_PAPER_DB / PAPER_DB_PATH
