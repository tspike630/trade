+def judge_delivery(required: Sequence[str], receipts: Sequence[Mapping[str, Any]]) -> DeliveryJudgement:
+    by_channel = {str(item.get("channel")): bool(item.get("ok")) for item in receipts}
+    ok_channels = tuple(name for name in required if by_channel.get(name))
+    if not required:
+        outcome = "not_configured"
+    elif len(ok_channels) == len(tuple(required)):
+        outcome = "delivered"
+    elif ok_channels:
+        outcome = "partial"
+    else:
+        outcome = "failed"
+    public = tuple(
+        {"channel": str(item.get("channel")), "ok": bool(item.get("ok")), "detail": item.get("detail", "")}
+        for item in receipts
+    )
+    return DeliveryJudgement(outcome, public, ok_channels, tuple(required))
+
+
+def _channels_to_send(prior: Mapping[str, Any], decision: AlertDecision, required: Sequence[str]) -> tuple[str, ...]:
+    if not prior.get("pending_retry"):
+        return tuple(required)
+    if prior.get("pending_event_key") != decision.event_key:
+        return tuple(required)
+    done = set(str(item) for item in (prior.get("pending_channel_ok") or []))
+    return tuple(name for name in required if name not in done)
