+def observed_source_bucket(findings: Sequence[Any]) -> int | None:
+    """Bucket of an observed source bar. Computation clocks are ignored."""
+    five: list[int] = []
+    hours: list[int] = []
+    for finding in findings:
+        if not is_lockout_code(str(getattr(finding, "code", "") or "")):
+            continue
+        detail = _detail(finding)
+        for key in _FIVE_MIN_SOURCE_KEYS:
+            stamp = _source_ms(detail.get(key))
+            if stamp is not None:
+                five.append(stamp)
+        for key in _HOUR_SOURCE_KEYS:
+            stamp = _source_ms(detail.get(key))
+            if stamp is not None:
+                hours.append(stamp)
+    if five:
+        return max(five) // FIVE_MIN_MS
+    if hours:
+        return max(hours) // FIVE_MIN_MS
+    return None
+
