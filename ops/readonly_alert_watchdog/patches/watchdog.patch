+def _advance_bars(has_lockout: bool, bucket: int | None, prior: Mapping[str, Any]) -> int:
+    if not has_lockout or bucket is None:
+        return 0
+    if int(prior.get("state_version") or 0) != STATE_VERSION:
+        return 1
+    prev_bucket = prior.get("last_lockout_bar_bucket")
+    prev_bars = int(prior.get("consecutive_lockout_bars") or 0)
+    if prev_bucket is None:
+        return 1
+    previous = int(prev_bucket)
+    if bucket == previous:
+        return max(1, prev_bars)
+    if bucket == previous + 1:
+        return prev_bars + 1
+    return 1
 
 
