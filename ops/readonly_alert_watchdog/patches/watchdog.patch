+    for item in findings:
+        code = str(getattr(item, "code", "") or "")
+        all_codes.add(code)
+        if getattr(item, "severity", "") == "RED" and code not in _NO_SIGNAL_CODES:
+            red_codes.add(code)
+    if red_codes & _SELF_FAULT_CODES:
