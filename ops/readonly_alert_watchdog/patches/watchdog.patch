+def _source_ms(value: object) -> int | None:
+    if isinstance(value, bool) or value is None or isinstance(value, float):
+        return None
+    if isinstance(value, str):
+        text = value.strip()
+        if not text or not text.lstrip("-").isdigit():
+            return None
+        value = int(text)
+    if not isinstance(value, int):
+        return None
+    if value < _MS_MIN:
+        return None
+    return value
+
+
+def _objects(detail: Mapping[str, Any]) -> tuple[str, ...]:
+    found: list[str] = []
+    for key in _OBJECT_KEYS:
+        value = detail.get(key)
+        if isinstance(value, str) and value.strip():
+            found.append(f"{key}={value.strip()}")
+    for key in _OBJECT_LIST_KEYS:
+        value = detail.get(key)
+        if isinstance(value, (list, tuple)):
+            for item in value:
+                if isinstance(item, str) and item.strip():
+                    found.append(f"{key}={item.strip()}")
+    return tuple(sorted(set(found)))
+
+
+def finding_fingerprint(finding: Any) -> str:
+    code = str(getattr(finding, "code", "") or "")
+    objects = _objects(_detail(finding))
+    if not objects:
+        return code
+    return code + "|" + ",".join(objects)
+
