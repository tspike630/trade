+def _inspect_volume_source_hour(
+    conn: sqlite3.Connection,
+    *,
+    now_ms: int,
+    main_info: dict[str, Any],
+    findings: list[Finding],
+) -> None:
+    """1h volume freshness is source_close_time_ms. computed_at_ms is not the clock."""
+    if not table_exists(conn, "decision_volume_z"):
+        main_info["volume_z_table_present"] = False
+        main_info["volume_z_source_hour_observed"] = False
+        return
+    cols = present_columns(conn, "decision_volume_z")
+    main_info["volume_z_table_present"] = True
+    if "source_close_time_ms" not in cols:
+        main_info["volume_z_source_hour_observed"] = False
+        findings.append(
+            Finding(
+                severity="RED",
+                surface="data_clocks",
+                code="volume_z_source_close_absent",
+                summary="decision_volume_z 没有 source_close_time_ms，不能用 computed_at_ms 充当 1h 源钟",
+                detail={"source_close_time_ms": None, "computed_at_ignored": True},
+            )
+        )
+        return
+    computed_sql = ", computed_at_ms" if "computed_at_ms" in cols else ""
+    rows = conn.execute(
+        f"SELECT symbol, source_close_time_ms{computed_sql} FROM decision_volume_z"
+    ).fetchall()
+    stale: list[dict[str, Any]] = []
+    fresh = 0
+    for row in rows:
+        close_ms, err = parse_any_ts_ms(row["source_close_time_ms"])
+        computed = row["computed_at_ms"] if "computed_at_ms" in cols else None
+        age = (now_ms - close_ms) if close_ms is not None else None
+        item = {
+            "symbol": str(row["symbol"] or ""),
+            "source_close_time_ms": close_ms,
+            "computed_at_ms": computed,
+            "age_ms": age,
+            "parse_error": err,
+        }
+        if err or close_ms is None or age is None or age < 0 or age > INDICATORS_FRESH_MS:
+            stale.append(item)
+        else:
+            fresh += 1
+    main_info["volume_z"] = {"fresh_rows": fresh, "stale_rows": len(stale), "computed_at_ignored": True}
+    main_info["volume_z_source_hour_observed"] = True
+    if not rows or stale:
+        code = "volume_z_source_close_absent" if not rows else "volume_z_source_close_stale"
+        worst = min((item["source_close_time_ms"] or 0) for item in stale) if stale else None
+        symbols = [item["symbol"] for item in stale if item["symbol"]]
+        findings.append(
+            Finding(
+                severity="RED",
+                surface="data_clocks",
+                code=code,
+                summary=(
+                    "1h 量能源钟 source_close_time_ms 缺失、超 3600s 或落在未来；"
+                    "computed_at_ms 不参与新鲜度"
+                ),
+                detail={
+                    "symbols": symbols,
+                    "source_close_time_ms": worst,
+                    "stale": stale[:8],
+                    "computed_at_ignored": True,
+                },
+            )
+        )
+
+
+_QUOTE_FUTURE_SKEW_MS = 120_000
+
+
+def _column_map(conn: sqlite3.Connection, table_name: str) -> dict[str, str]:
+    return {name.lower(): name for name in present_columns(conn, table_name)}
+
+
+def _ccxt_source_ms(raw: object) -> tuple[int | None, str | None]:
+    """``ccxt_ticks.ts`` as used by live_bnb_turnover: ms, or seconds rescaled once."""
+    if isinstance(raw, bool) or raw is None or raw == "":
+        return None, None
+    if isinstance(raw, (int, float)):
+        if isinstance(raw, float) and not math.isfinite(raw):
+            return None, "non_finite"
+        number = int(raw)
+        if number > 10_000_000_000:
+            return number, None
+        if number > 1_000_000_000:
+            return number * 1000, "seconds_rescaled"
+        return None, "not_a_source_stamp"
+    return parse_any_ts_ms(raw)
+
+
+def _quote_feed_state(stamp_ms: int, now_ms: int) -> str:
+    age = now_ms - stamp_ms
+    if age < -_QUOTE_FUTURE_SKEW_MS:
+        return "future"
+    if age > INDICATORS_FRESH_MS:
+        return "stale"
+    return "fresh"
+
