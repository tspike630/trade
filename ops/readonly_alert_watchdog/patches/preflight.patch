+def annotate_funnel_posture(clock_findings: Sequence[Finding], funnel: dict[str, Any]) -> None:
+    """Separate a normal no-entry result from a data-clock lockout.
+
+    An empty decision_log is not a no-entry signal: the process may simply
+    not have written. Quote turnover is not judged here; this module does not
+    read that clock.
+    """
+    lock_codes = sorted(
+        {
+            item.code
+            for item in clock_findings
+            if item.severity == "RED" and item.code in _DATA_LOCKOUT_CODES
+        }
+    )
+    passed = funnel.get("risk_passed_by_purpose") or {}
+    buy_count = sum(int(value) for value in passed.values()) if isinstance(passed, Mapping) else 0
+    rows = int(funnel.get("decision_rows_in_window") or 0)
+    funnel["buy_count"] = buy_count
+    funnel["data_lock_codes"] = lock_codes
+    if lock_codes:
+        funnel["posture"] = "data_lockout"
+        funnel["data_lockout"] = True
+        funnel["evaluated"] = rows > 0
+        return
+    funnel["data_lockout"] = False
+    if rows > 0 and buy_count == 0:
+        funnel["posture"] = "no_entry_signal"
+        funnel["evaluated"] = True
+        return
+    if rows > 0:
+        funnel["posture"] = "entries_present"
+        funnel["evaluated"] = True
+        return
+    funnel["posture"] = "unspecified"
+    funnel["evaluated"] = False
 
 
