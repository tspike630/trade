# t250u draft, 2026-11-14 11:56 HKT. Non-secret. Not sourced by production.
# Source defaults stay off until a process sources this file.
# Keys below that the router does not read do not change live sizing or exits.
# Do not put API keys, secrets, tokens, or webhook URLs here.
# Do not hardcode a historical USDT balance.

REGIME_V2_CONTRACT=1
REGIME_V2_POSITION_PCT=0.24
REGIME_V2_POSITION_STATUS=live_cli_fact_not_a_new_approval
REGIME_V2_NOTIONAL_FORMULA=live_base*0.24*entry_tier*state_multiplier

USE_OPTIMAL_KELLY_MATRIX=0
EXPAND_REGIME_OCO_TP=0
ENABLE_PERP_SHORT_ENGINE=0
BINANCE_PERP_SHORT_LIVE_ENABLED=0
ENFORCE_REAL_DEMAND_WHITELIST=0
LIVE_BNB_INVERSE_VOL_SIZING=0
LIVE_BNB_CLUSTER_CAP_ENABLED=0
LIVE_BNB_PORTFOLIO_BETA_GATE=0
BINANCE_SPOT_SOR_MAKER_FALLBACK=0

BINANCE_SPOT_TRAILING_RATCHET=0
BINANCE_SPOT_MAX_HOLD_SEC=0
BINANCE_SPOT_AUTO_FLATTEN_ON_OCO_FAIL=1
# Ruling asked this flag = 1. Production reanchor keeps a relative gap from
# min/max(fill, mark) and runs only when the original band does not contain
# the fill. It is not "always once from the fill average, never amend".
# Leaving the flag at 0 until that mismatch is cleared.
BINANCE_SPOT_REANCHOR_OCO_ON_FILL=0
REGIME_V2_REANCHOR_RULING=1
REGIME_V2_REANCHOR_STATUS=blocked_behavior_mismatch

# Ruled multipliers. No router code reads these keys.
REGIME_V2_STATE1_SIZE_MULTIPLIER=1.00
REGIME_V2_STATE1_TP_MULTIPLIER=1.00
REGIME_V2_STATE2_SIZE_MULTIPLIER=1.20
REGIME_V2_STATE2_TP_MULTIPLIER=1.35
REGIME_V2_STATE2_ENTRY_STATUS=module_not_called
REGIME_V2_STATE3_SIZE_MULTIPLIER=1.15
REGIME_V2_STATE3_TP_MULTIPLIER=1.25
REGIME_V2_STATE4_SIZE_MULTIPLIER=0.30
REGIME_V2_STATE4_TP_MULTIPLIER=0.85
REGIME_V2_STATE4_ENTRY_STATUS=deep_tier_undefined
REGIME_V2_STATE5_SIZE_MULTIPLIER=0
REGIME_V2_STALE_DATA_POLICY=fail_closed_not_implemented

# Existing opt-in gates. Post-only changes neutral LIMIT to LIMIT_MAKER.
# large_trade_market stays MARKET. Order-book gate is execution-side.
BINANCE_SPOT_ORDERBOOK_GATE=1
BINANCE_SPOT_POST_ONLY_LIMIT=1
LIVE_BNB_POST_ONLY_LIMIT=1

PUBLIC_DERIVATIVES_DB_PATH=data/counterparty/public_derivatives.db
NEWS_EVENTS_DB_PATH=news_events.db
DECISION_MACRO_GATE_ENABLED=1
DECISION_MACRO_DB=data/lseg/lseg_macro.db
LSEG_MACRO_DB_PATH=data/lseg/lseg_macro.db

DECISION_EXECUTION_LEDGER_FADE=execution_ledger_live_bnb_boll_fade.db
DECISION_EXECUTION_LEDGER_CLASSIC=execution_ledger_live_bnb_boll_classic.db
