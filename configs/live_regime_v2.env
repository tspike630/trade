# Regime v2 profile. Non-secret. Source defaults stay off until a process
# sources this file. Do not put API keys, secrets, or webhook URLs here.
#
# 2026-11-12 13:38 baseline remains 24% of book. Lifting the temporary freeze
# did not choose a new fraction. Kelly 18.5/20/45/35/5/95 is not selected.
# Perp short is not authorized. Trailing ratchet and max hold stay 0.
# State 4 tp 0.80 is a stamp only; EXPAND_REGIME_OCO_TP widens state 2/3 and
# stays off. An independent entry module is not specified; the entry remains
# tech_boll_fade_v1 plus live_bnb_entry_zone.

REGIME_V2_POSITION_PCT=0.24
REGIME_V2_POSITION_STATUS=pending_ruling

USE_OPTIMAL_KELLY_MATRIX=0
EXPAND_REGIME_OCO_TP=0
ENABLE_PERP_SHORT_ENGINE=0
BINANCE_PERP_SHORT_LIVE_ENABLED=0
ENFORCE_REAL_DEMAND_WHITELIST=0
LIVE_BNB_INVERSE_VOL_SIZING=0

BINANCE_SPOT_TRAILING_RATCHET=0
BINANCE_SPOT_MAX_HOLD_SEC=0
BINANCE_SPOT_REANCHOR_OCO_ON_FILL=0

# Opt-in gates. Unset in source code means off.
BINANCE_SPOT_ORDERBOOK_GATE=1
BINANCE_SPOT_POST_ONLY_LIMIT=1
LIVE_BNB_POST_ONLY_LIMIT=1
BINANCE_SPOT_SOR_MAKER_FALLBACK=1

# Feature stores. Freshness is the row clock, not the file mtime.
PUBLIC_DERIVATIVES_DB_PATH=data/counterparty/public_derivatives.db
NEWS_EVENTS_DB_PATH=news_events.db
DECISION_MACRO_GATE_ENABLED=1
DECISION_MACRO_DB=data/lseg/lseg_macro.db
LSEG_MACRO_DB_PATH=data/lseg/lseg_macro.db

# One ledger per purpose. The isolated dry-run overrides DECISION_EXECUTION_LEDGER
# and must not open these files.
DECISION_EXECUTION_LEDGER_FADE=execution_ledger_live_bnb_boll_fade.db
DECISION_EXECUTION_LEDGER_CLASSIC=execution_ledger_live_bnb_boll_classic.db
