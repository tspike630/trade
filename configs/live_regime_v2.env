# Regime v2 ruled profile (Phase 2 strategy & freshness rules locked).
# Non-secret. Source defaults stay off until a process sources this file.
# Do not put API keys, secrets, passwords, or webhook URLs here.
# Do not hardcode a historical USDT balance.

REGIME_V2_CONTRACT=1
REGIME_V2_POSITION_PCT=0.24
REGIME_V2_POSITION_STATUS=live_cli_fact_not_a_new_approval
REGIME_V2_NOTIONAL_FORMULA=live_equity_usdt*0.24*entry_tier*state_multiplier
REGIME_V2_EQUITY_SOURCE=signed_account_snapshot
REGIME_V2_ACCOUNT_SNAPSHOT_MAX_AGE_SEC=300
REGIME_V2_ENTRY_KLINE_5M_MAX_AGE_SEC=900

USE_OPTIMAL_KELLY_MATRIX=0
EXPAND_REGIME_OCO_TP=0
ENABLE_PERP_SHORT_ENGINE=0
BINANCE_PERP_SHORT_LIVE_ENABLED=0
ENFORCE_REAL_DEMAND_WHITELIST=0
LIVE_BNB_INVERSE_VOL_SIZING=0
LIVE_BNB_CLUSTER_CAP_ENABLED=1
LIVE_BNB_PORTFOLIO_BETA_GATE=1
BINANCE_SPOT_SOR_MAKER_FALLBACK=0

BINANCE_SPOT_TRAILING_RATCHET=0
BINANCE_SPOT_MAX_HOLD_SEC=0
BINANCE_SPOT_AUTO_FLATTEN_ON_OCO_FAIL=1
# Legacy reanchor stays 0; first-hang Formula B is governed separately on the executor.
BINANCE_SPOT_REANCHOR_OCO_ON_FILL=0
REGIME_V2_REANCHOR_RULING=1
REGIME_V2_REANCHOR_STATUS=blocked_behavior_mismatch

# Ruled 5-state multipliers and S2/S4 entry gates
REGIME_V2_STATE1_SIZE_MULTIPLIER=1.00
REGIME_V2_STATE1_TP_MULTIPLIER=1.00
REGIME_V2_STATE2_SIZE_MULTIPLIER=1.20
REGIME_V2_STATE2_TP_MULTIPLIER=1.35
REGIME_V2_STATE2_ENTRY_STATUS=live_squeeze_limit_maker_gated
REGIME_V2_S2_FUNDING_Z_MAX=-1.80
REGIME_V2_S2_FUNDING_RATE_MAX=-0.0003
REGIME_V2_S2_MIN_TAKER_BUY_RATIO=0.48
REGIME_V2_S2_MIN_OBI_TOP5=-0.05
REGIME_V2_S2_ALPHA_CAP=0.55
REGIME_V2_S2_MIN_ODDS=1.50
REGIME_V2_STATE3_SIZE_MULTIPLIER=1.15
REGIME_V2_STATE3_TP_MULTIPLIER=1.25
REGIME_V2_STATE4_SIZE_MULTIPLIER=0.30
REGIME_V2_STATE4_TP_MULTIPLIER=0.85
REGIME_V2_STATE4_ENTRY_STATUS=live_deep_dip_limit_maker_gated
REGIME_V2_S4_BOLL_Z_MAX=-2.20
REGIME_V2_S4_ALPHA_CAP=0.15
REGIME_V2_S4_MIN_TAKER_BUY_RATIO=0.38
REGIME_V2_S4_MIN_OBI_TOP5=-0.15
REGIME_V2_S4_MIN_ODDS=3.00
REGIME_V2_S4_WHITELIST_ONLY=1
REGIME_V2_STATE5_SIZE_MULTIPLIER=0
REGIME_V2_STALE_DATA_POLICY=fail_closed

# Concurrency, cluster, single-name & total portfolio exposure caps
LIVE_BNB_TOP_BUYS=2
REGIME_V2_MAX_CONCURRENT_POSITIONS=3
REGIME_V2_STATE4_MAX_CONCURRENT_POSITIONS=1
REGIME_V2_MAX_PER_CLUSTER=1
REGIME_V2_MAX_SINGLE_EXPOSURE_PCT=0.30
REGIME_V2_MAX_TOTAL_EXPOSURE_PCT=0.72
REGIME_V2_STATE4_MAX_TOTAL_EXPOSURE_PCT=0.30
REGIME_V2_MAX_PORTFOLIO_BETA=0.85
REGIME_V2_STATE4_MAX_PORTFOLIO_BETA=0.35

# Existing opt-in gates
BINANCE_SPOT_ORDERBOOK_GATE=1
BINANCE_SPOT_POST_ONLY_LIMIT=1
LIVE_BNB_POST_ONLY_LIMIT=1

PUBLIC_DERIVATIVES_DB_PATH=data/counterparty/public_derivatives.db
NEWS_EVENTS_DB_PATH=news_events.db
DECISION_MACRO_GATE_ENABLED=1
DECISION_MACRO_DB=data/lseg/lseg_macro.db
LSEG_MACRO_DB_PATH=data/lseg/lseg_macro.db
CITYU_INSTITUTIONAL_DB_PATH=data/institutional/cityu_institutional.db

DECISION_EXECUTION_LEDGER_FADE=execution_ledger_live_bnb_boll_fade.db
